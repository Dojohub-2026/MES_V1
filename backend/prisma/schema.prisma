generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  name           String
  identifier     String           @unique
  credentialHash String
  role           Role
  isActive       Boolean          @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  phone          String?
  skills         String[]         @default([])
  faultsLogged   FaultLog[]       @relation("FaultOperator")
  assignedStages JobStage[]       @relation("StageOperator")
  sessions       ProcessSession[] @relation("SessionOperator")
  managedLines   ProductionLine[] @relation("LineManager")

  @@map("users")
}

model ProductionLine {
  id             String    @id @default(uuid())
  lineCode       String    @unique
  name           String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  managerId      String?
  targetDate     DateTime?
  targetProduct  String?
  targetQuantity Int?
  unit           String?
  jobs           Job[]
  manager        User?     @relation("LineManager", fields: [managerId], references: [id])

  @@index([managerId])
  @@map("production_lines")
}

model Blueprint {
  id                        String                   @id @default(uuid())
  name                      String
  description               String?
  category                  String
  skillCategory             String?
  stationTag                String?
  estimatedDurationMinutes  Int                      @default(0)
  isArchived                Boolean                  @default(false)
  guidelinesEnabled         Boolean                  @default(false)
  guidelinesContent         String?
  checklistEnabled          Boolean                  @default(false)
  checklistValidationTiming String?
  quantityLoggingEnabled    Boolean                  @default(false)
  qcFormEnabled             Boolean                  @default(false)
  faultCategoriesEnabled    Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  checklistItems            BlueprintChecklistItem[]
  faultCategories           BlueprintFaultCategory[]
  qcQuestions               BlueprintQcQuestion[]
  quantities                BlueprintQuantity[]
  stages                    JobStage[]

  @@map("blueprints")
}

model BlueprintQuantity {
  id             String                 @id @default(uuid())
  blueprintId    String
  metricName     String
  unitLabel      String
  minValue       Float?
  maxValue       Float?
  inputFrequency QuantityInputFrequency @default(PER_BATCH)
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  blueprint      Blueprint              @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_quantities")
}

model BlueprintChecklistItem {
  id          String    @id @default(uuid())
  blueprintId String
  itemText    String
  isRequired  Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_checklist_items")
}

model BlueprintQcQuestion {
  id              String       @id @default(uuid())
  blueprintId     String
  questionText    String
  responseType    String
  numericMinValue Float?
  numericMaxValue Float?
  isRequired      Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  blueprint       Blueprint    @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  responses       QcResponse[]

  @@map("blueprint_qc_questions")
}

model BlueprintFaultCategory {
  id          String        @id @default(uuid())
  blueprintId String
  faultName   String
  // severity    FaultSeverity
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  blueprint   Blueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("blueprint_fault_categories")
}

model Job {
  id                   String                   @id @default(uuid())
  jobId                String                   @unique
  name                 String
  productName          String?
  targetQuantity       Int                      @default(0)
  unit                 String                   @default("Units")
  status               JobStatus                @default(DRAFT)
  notes                String?
  targetDate           DateTime?
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdById          String?
  lineId               String?
  source               JobSource                @default(MANUAL)
  externalWorkOrderId  String?                  @unique
  batchNumber          String?
  actualProducedQty    Int?
  actualScrapQty       Int?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  faults               FaultLog[]
  stages               JobStage[]
  line                 ProductionLine?          @relation(fields: [lineId], references: [id])
  materialRequirements JobMaterialRequirement[]
  downtimeLogs         JobDowntimeLog[]
  scrapLogs            ScrapLog[]

  @@map("jobs")
}

model JobStage {
  id                       String           @id @default(uuid())
  jobId                    String
  blueprintId              String?
  stageOrder               Int
  stageName                String
  instruction              String?
  requiresQc               Boolean          @default(false)
  estimatedDurationMinutes Int              @default(0)
  stationTag               String?
  status                   StageStatus      @default(PENDING)
  notes                    String?
  operatorId               String?
  scheduledStartAt         DateTime?
  scheduledEndAt           DateTime?
  actualStartedAt          DateTime?
  actualEndedAt            DateTime?
  createdAt                DateTime         @default(now())
  faults                   FaultLog[]
  blueprint                Blueprint?       @relation(fields: [blueprintId], references: [id])
  job                      Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  operator                 User?            @relation("StageOperator", fields: [operatorId], references: [id])
  sessions                 ProcessSession[]
  scrapLogs                ScrapLog[]
  qcResponses              QcResponse[]

  @@unique([jobId, stageOrder])
  @@map("job_stages")
}

model ScrapLog {
  id        String    @id @default(uuid())
  jobId     String
  stageId   String?
  quantity  Float
  unit      String
  wasteType String
  notes     String?
  loggedAt  DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage     JobStage? @relation(fields: [stageId], references: [id])

  @@map("scrap_logs")
}

model JobMaterialRequirement {
  id            String   @id @default(uuid())
  jobId         String
  name          String
  qtyPerUnit    Float
  unit          String
  totalRequired Float
  wastagePct    Float?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_material_requirements")
}

model JobDowntimeLog {
  id        String    @id @default(uuid())
  jobId     String
  stageId   String?
  startedAt DateTime
  endedAt   DateTime?
  reason    String
  category  String?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_downtime_logs")
}

model QcResponse {
  id           String              @id @default(uuid())
  stageId      String
  questionId   String
  responseText String?
  passed       Boolean?
  loggedAt     DateTime            @default(now())
  stage        JobStage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  question     BlueprintQcQuestion @relation(fields: [questionId], references: [id])

  @@unique([stageId, questionId])
  @@map("qc_responses")
}

model ProcessSession {
  id         String       @id @default(uuid())
  stageId    String
  operatorId String?
  startedAt  DateTime     @default(now())
  endedAt    DateTime?
  notes      String?
  batches    BatchEntry[]
  operator   User?        @relation("SessionOperator", fields: [operatorId], references: [id])
  stage      JobStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("process_sessions")
}

model BatchEntry {
  id           String         @id @default(uuid())
  sessionId    String
  batchNumber  Int
  loggedAt     DateTime       @default(now())
  quantityData Json
  notes        String?
  session      ProcessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, batchNumber])
  @@map("batch_entries")
}

model FaultLog {
  id              String        @id @default(uuid())
  jobId           String
  stageId         String?
  operatorId      String?
  title           String
  description     String?
  severity        FaultSeverity
  category        String?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  loggedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  job             Job           @relation(fields: [jobId], references: [id])
  operator        User?         @relation("FaultOperator", fields: [operatorId], references: [id])
  stage           JobStage?     @relation(fields: [stageId], references: [id])

  @@map("fault_logs")
}

enum Role {
  EXECUTIVE
  MANAGER
  OPERATOR
  ERP
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum JobSource {
  MANUAL
  ERP
}

enum StageStatus {
  PENDING
  AVAILABLE
  RUNNING
  PAUSED
  COMPLETED
}

enum FaultSeverity {
  CRITICAL
  MINOR
}

enum QuantityInputFrequency {
  ONCE
  PER_BATCH
  HOURLY
}
